@page
@model MrBoom.Server.Admin.DashboardModel
<h1>Suck my dick, dear admin!</h1>

<h2>Enjoy the stats of your little niggers:</h2>

<table>
	<thead>
		<tr>
			<th style="min-width: 200px">IP</th>
			<th style="min-width: 200px">Received</th>
			<th style="min-width: 200px">Sent</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var entry in Model.Metrics.GetMetrics())
		{
			<tr>
				<td>@entry.Key</td>
				<td>@entry.Value.PacketsReceived (@(entry.Value.BytesReceived / 1024) KB, @entry.Value.AverageBytesReceived bytes / Packet)</td>
				<td>@entry.Value.PacketsSent (@(entry.Value.BytesSent / 1024) KB, @entry.Value.AverageBytesSent bytes / Packet)</td>
			</tr>
		}
	</tbody>
</table>
